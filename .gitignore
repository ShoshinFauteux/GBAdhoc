*.gba
*.GBA
gba_bios.bin
GBA_BIOS.bin
# Build intermediates
*.o
*.d
*.elf
*.a
gpsp/sdl/gpsp_sdl
# psp/Makefile writes the link script from psp/gbadhoc.ld.in on every make
gpsp/psp/gbadhoc.ld
gpsp/psp/groups.ld
gpsp/psp/pins.ld
# Run artifacts
logs/
*.log
# Build products: every build makes them (tools/build.sh); releases ship them as assets
/builds/harness/*.PBP
/builds/harness/*.prx
/builds/playable/*.PBP
/builds/playable/*.prx
# Python bytecode
__pycache__/
*.pyc
