diff --git a/mips/mips_emit.h b/mips/mips_emit.h
index 1aeac6f..04cdab4 100644
--- a/mips/mips_emit.h
+++ b/mips/mips_emit.h
@@ -1404,9 +1404,7 @@ u32 execute_store_cpsr_body(u32 _cpsr, u32 address)
   if((io_registers[REG_IE] & io_registers[REG_IF]) &&
    io_registers[REG_IME] && ((_cpsr & 0x80) == 0))
   {
-    /* address is the MSR's own; the IRQ is taken after it, so LR_irq =
-       the next instruction + 4 (SUBS pc, lr, #4 used to re-run the MSR). */
-    REG_MODE(MODE_IRQ)[6] = address + 8;
+    REG_MODE(MODE_IRQ)[6] = address + 4;
     REG_SPSR(MODE_IRQ) = _cpsr;
     IRQCHK_ENTER(3);
     reg[REG_CPSR] = 0xD2;
@@ -1427,30 +1425,11 @@ u32 execute_store_cpsr_body(u32 _cpsr, u32 address)
   generate_load_imm(reg_a1, spsr_masks[psr_pfield]);                          \
   generate_function_call_swap_delay(execute_store_spsr)                       \
 
-/* MSR CPSR_c (control field only): execute_store_cpsr keeps the CPSR bits
- * outside the mask from reg[REG_CPSR], whose NZCV is stale while the flags
- * live in reg_n/z/c/v_cache, and the extract that follows loaded those stale
- * flags back (an IRQ raised there saved them in SPSR_irq).  Put the live
- * flags in the value and store the f field too: the same CPSR with the
- * current NZCV, in every mode (the f field is writable in user mode too).
- * ARM blocks always generate all flags (arm_dead_flag_eliminate). */
-#define arm_psr_cpsr_live_flags()                                             \
-  if(psr_pfield == 1)                                                         \
-  {                                                                           \
-    mips_emit_sll(reg_a0, reg_a0, 4);                                         \
-    mips_emit_srl(reg_a0, reg_a0, 4);                                         \
-    insert_bits(reg_a0, reg_n_cache, reg_temp, 31, 1);                        \
-    insert_bits(reg_a0, reg_z_cache, reg_temp, 30, 1);                        \
-    insert_bits(reg_a0, reg_c_cache, reg_temp, 29, 1);                        \
-    insert_bits(reg_a0, reg_v_cache, reg_temp, 28, 1);                        \
-  }                                                                           \
-
 #define arm_psr_store_cpsr()                                                  \
-  arm_psr_cpsr_live_flags();                                                  \
   generate_load_pc(reg_a1, (pc));                                             \
   generate_function_call_swap_delay(execute_store_cpsr);                      \
-  generate_raw_u32(cpsr_masks[psr_pfield == 1 ? 3 : psr_pfield][0]);          \
-  generate_raw_u32(cpsr_masks[psr_pfield == 1 ? 3 : psr_pfield][1]);          \
+  generate_raw_u32(cpsr_masks[psr_pfield][0]);                                \
+  generate_raw_u32(cpsr_masks[psr_pfield][1]);                                \
 
 #define arm_psr_store(op_type, psr_reg)                                       \
   arm_psr_load_new_##op_type();                                               \
