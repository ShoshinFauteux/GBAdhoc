# pins.awk -- psp/pins.ld from tools/layout/layout.lock (code-health C3-3;
# docs/LAYOUT-PINNING.md "Pins").  psp/Makefile runs it on every make:
#
#   awk -v flavour=FLAVOUR -v strict=0|1 -f pins.awk layout.lock > pins.ld
#
# For each `pin NAME ADDR` line of the lock's [FLAVOUR] section it writes
# `__pin_NAME = ADDR;`, plus `__pin_strict`.  gbadhoc.ld (pin main) and
# groups.ld (the others) use them as
#
#   ASSERT(__pin_strict == 0 || ABSOLUTE(.) <= __pin_NAME, "...");
#   . = ABSOLUTE(ABSOLUTE(.) + ((__pin_NAME - ABSOLUTE(.)) & 0x1FFF));
#
# (groups_ld.sh says why the outer ABSOLUTE)
#
# so the region after the pin starts at ADDR mod 8 KiB, at ADDR itself as long
# as the code before it fits.  POSIX awk only: it runs in the pspdev image (no
# python there).  A flavour without pins, or one missing a pin the scripts
# name, stops the make.
BEGIN {
  if (flavour == "") { print "pins.awk: no flavour (LAYOUT_FLAVOUR)" > "/dev/stderr"; exit 2 }
  need["main"] = 1; need["fe_head"] = 1; need["fe_common"] = 1
  need["fe_tail"] = 1; need["core"] = 1
  print "/* pins.ld -- GENERATED by psp/Makefile from tools/layout/layout.lock [" flavour "]"
  print " * with tools/layout/pins.awk (docs/LAYOUT-PINNING.md \"Pins\").  Never edit. */"
  print "__pin_strict = " (strict == "1" ? 1 : 0) ";"
}
{ sub(/\r$/, "") }
/^\[[A-Za-z0-9_]+\]/ { cur = substr($1, 2, length($1) - 2); next }
cur == flavour && $1 == "pin" {
  if ($3 !~ /^0x[0-9a-fA-F]+$/) {
    print "pins.awk: layout.lock [" flavour "] pin " $2 ": bad address " $3 > "/dev/stderr"; bad = 1; exit 2
  }
  print "__pin_" $2 " = " $3 ";"
  got[$2] = 1
}
END {
  if (bad) exit 2
  for (n in need) if (!(n in got)) {
    print "pins.awk: layout.lock [" flavour "] has no `pin " n "`" > "/dev/stderr"; miss = 1
  }
  if (miss) exit 2
}
