# tools/layout/lab-pads.env -- the layout pads of a lab build (tools/build.sh lab).
#
# A lab build carries lab-only code in main() before the frame loop and around
# pace_frame, so the release pads (psp/Makefile) put its loop window 160 B off
# a lab build of round 3 (0802244e).  These values were tuned in claude/opt-1000
# round 7 against that ELF and are what hardware arm C (builds/r7-lab, EBOOT
# 5a3c4b45) was built with.  tools/build.sh lab applies them unless LAB_PADS=0;
# an explicit LAYOUT_PAD_BYTES= or PSP_EXTRA= still overrides them for a sweep.
# Re-tune with tools/layout/layout_lock.py solve lab, then check, then re-record
# [lab] in tools/layout/layout.lock.
LAYOUT_PAD_BYTES=1440
LAYOUT_PAD_BSCAN_BYTES=7864
LAYOUT_PAD_FE_BYTES=3332
LAYOUT_PAD_GB_BYTES=696
LAYOUT_PAD_CORE_BYTES=5532
LAYOUT_PAD_RO_BYTES=24
