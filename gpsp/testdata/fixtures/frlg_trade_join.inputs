# frlg_trade_join.inputs — Union Room trade, JOIN side, FireRed/LeafGreen.
#
# *** UNVERIFIED — pending user-supplied parked saves. ***
# FR/LG transliteration of emerald_trade_join.inputs; see the header of
# frlg_trade_host.inputs for the address-confidence split and for the
# fixture contract the supplied .sav has to satisfy (parked on a Pokemon
# Center 2F at (6,4) facing north, Pokedex obtained, 2+ non-egg Kanto-dex
# party mons).
#
# Flow: CONTINUE -> attendant -> YES -> in-game save -> warp Union Room ->
# wait out the host's registration -> walk to the trading board (2,1), stand
# (2,2) facing up -> mash A.  The board tile is hard-coded in
# union_room.c IsPlayerFacingTradingBoard as (2 + MAP_OFFSET, 1 + MAP_OFFSET)
# in FR/LG exactly as in Emerald, and the Union Room layout is identical, so
# the Emerald route works unchanged.
#
# Oracle: join gives slot-1 personality (pre0), receives the host's
# registered slot-2 mon into slot 1: post0 == host pre1, post1 == pre1.
# NOTE: no `ff on` — a netdrv session is active, FF is interlocked to 1x.

# --- boot -> title -> CONTINUE -> overworld (parked at PC2F (6,4)) ----------
mash A 4 0x030030F4 0xFFFFFFFF 0x08078BB1 21600
evt title_ok
mash START 4 0x030030F4 0xFFFFFFFF 0x0800C2E9 3600
mash A 4 0x030030F4 0xFFFFFFFF 0x080565C9 7200
evt overworld_ok
wait 30
logptr start_loc 2 0x03005008 0x04
logram pre0 4 0x02024284
logram pre1 4 0x020242E8

# --- talk to the Union Room attendant: welcome -> YES -> save -> warp ------
press UP 2
wait 10
mashsram A 5400
evt entry_saved
mashptr A 2 0x03005008 0x04 0xFFFF 0x0400 3600
evt in_union_room

# --- wait for the Union Room task to reach UR_STATE_MAIN -------------------
waitptr 1 0x0203B05C 0x14 0xFF 4 1800
evt ur_main

# --- give the host time to register on the trading board (~45 s) -----------
wait 2700

# --- navigate (7,11) -> row 10 -> column 2 -> (2,2), facing the board ------
holdmash UP B 2 0x02036E4A 0xFFFF 17 600
holdmash DOWN B 2 0x02036E4A 0xFFFF 17 600
holdmash LEFT B 2 0x02036E48 0xFFFF 9 900
holdmash RIGHT B 2 0x02036E48 0xFFFF 9 600
holdmash UP B 2 0x02036E4A 0xFFFF 9 900
evt at_board

# --- one mash from the board to the trade screen ---------------------------
mash A 4 0x030030F4 0xFFFFFFFF 0x0805014D 21600
evt trade_anim

# --- trade animation runs itself; ends in an automatic in-game save --------
mashsram A 18000
evt post_save

# --- back to the Union Room field, then read the oracle --------------------
mash A 4 0x030030F4 0xFFFFFFFF 0x080565C9 7200
wait 60
logram post0 4 0x02024284
logram post1 4 0x020242E8
logram recv0 4 0x0202402C
logptr end_loc 2 0x03005008 0x04
dump
evt trade_complete
wait 60
