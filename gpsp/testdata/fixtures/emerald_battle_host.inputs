# EMERALD WIRELESS DOUBLE BATTLE (regression gate) -- HOST (link leader)   docs/RIG-DOUBLE-BATTLE.md
# ---------------------------------------------------------------------------
# Every step that changes game state is CLOSED-LOOP: a RAM predicate proves
# the press took effect before the next one.  Where a single `press` is used,
# the very next line is the predicate that proves it.  No mash crosses a menu.
#
# DERIVED from frlg_battle_host.inputs by symbol substitution (pret/pokeemerald
# `symbols`, pokeemerald.sym, BPEE rev 0); boot and walk are the proven
# emerald_tradecenter sequence.  The FR/LG address table below is
# superseded by the substituted values in the body.
#   gMain.callback2        0x030022C4   CB2_TitleScreenRun|1 0x08078BB1
#                                       CB2_MainMenu|1       0x0800C2E9
#                                       CB2_Overworld|1      0x08085E5D
#                                       BattleMainCB2|1      0x08038421
#   gQuestLogState         0x0203ADFA   0 = no recap playing
#   sMenu (menu.c)         0x0203ADE4   +2 cursorPos, +4 maxCursorPos
#   gSaveBlock1Ptr         0x03005D8C   ->+4 location (u16 group|num<<8)
#   gObjectEvents[0]       x 0x02036E48, y 0x02036E4A (map + 7), facing 0x02036E50
#   sWirelessLinkMain      0x02022C30   Leader: ->+12 state
#   gBattlerControllerFuncs 0x03005D60  u32[4]; HandleInputChooseAction|1
#                                       0x08057589, HandleInputChooseMove|1
#                                       0x08057BFD, ...ChooseTarget|1 0x0802E689
#   gPlayerParty 0x020244EC / gEnemyParty 0x02024744, 100 bytes per mon:
#     +0 personality, +4 otId, +0x20..0x4F encrypted substructs, +0x56 hp
#   gBattleTypeFlags 0x02022FEC, gBattleOutcome 0x0202433A
#   gRfu recvQueue.count 0x030059E6, sendQueue.count 0x03005C1A
# The HOST's local battlers are 0 and 2 (the master's; §1.2, pinned in G1).
# ---------------------------------------------------------------------------

# ---- P1-P3 boot (the proven Emerald tradecenter sequence) --------------
mash A 4 0x030022C4 0xFFFFFFFF 0x080AAB2D 4800
evt title_ok
mash START 4 0x030022C4 0xFFFFFFFF 0x0802F6B1 3600
mash A 4 0x030022C4 0xFFFFFFFF 0x08085E5D 4800
evt overworld_ok
wait 30
evt questlog_done

# ---- P4 golden save parks in Mauville PC 2F; the tradecenter route to the
# Direct Corner attendant (hardware-proven; its UP press relies on the
# Emerald overworld's one-tile holdmash overshoot, HARNESS §4)
logptr loc 2 0x03005D8C 0x04
holdmash DOWN  B 2 0x02037362 0xFFFF 12 900
holdmash RIGHT B 2 0x02037360 0xFFFF 17 900
holdmash UP    B 2 0x02037362 0xFFFF 11 900
press UP 2
waitram 1 0x02037368 0x0F 2 60
evt parked_ok

# ---- P5 talk: the Direct Corner service menu (TRADE/COLOSSEUM/EXIT) --------
# G1 finding: a single `press A` right after the recap was swallowed by the
# field fade-in.  So: wait for the field to be idle (no script running), then
# mash A only until a script STARTS (sGlobalScriptContext.mode 0x03000E41
# leaves 0) -- the dialogue itself needs no key, so no A reaches a menu.
waitram 1 0x03000E41 0xFF 0 600
mashne A 1 0x03000E41 0xFF 0 600
evt talk_started
# The greeting has key-wait pages ("...DIRECT CORNER.<A>").  mashif presses A
# only while text printer 0 (sTextPrinters 0x02020034, +0x1B active) is busy,
# so it advances the dialogue and can never land on the menu that follows.
mashif A 1 0x020201CB 0xFF 1 1 0x0203CD94 0xFF 3 1800
logram svc_rows 1 0x0203CD94
waitram 1 0x0203CD92 0xFF 0 1
evt service_menu
# ---- P6 COLOSSEUM
mash DOWN 1 0x0203CD92 0xFF 1 300
# G1: a lone `press A` on a just-moved cursor was swallowed.  Mash A until the
# NEXT text starts printing (printer 0 active): the choice is proven taken and
# the mash stops before any A can reach the text or the next menu.
mash A 1 0x020201CB 0xFF 1 300
# ---- P7 battle mode menu (SINGLE/DOUBLE/MULTI/INFO/EXIT) -> DOUBLE
mashif A 1 0x020201CB 0xFF 1 1 0x0203CD94 0xFF 4 1800
waitram 1 0x0203CD92 0xFF 0 1
mash DOWN 1 0x0203CD92 0xFF 1 300
# G1: a lone `press A` on a just-moved cursor was swallowed.  Mash A until the
# NEXT text starts printing (printer 0 active): the choice is proven taken and
# the mash stops before any A can reach the text or the next menu.
mash A 1 0x020201CB 0xFF 1 300
evt chose_double
# ---- P8 save: "save the game?" YES, then "overwrite?" YES, the save lands.
# sSaveDialogCB (IWRAM 0x0203761C) names each state:
#   AskSaveHandleInput|1 0x080A0109, AskOverwriteOrReplace...HandleInput|1
#   0x080A01ED, ReturnSuccess|1 0x080A02D9 (auto-closes after 60 frames: the
#   "saved the game" text needs NO key -- a press there would reach the menu).
mashif A 1 0x020201CB 0xFF 1 4 0x0203761C 0xFFFFFFFF 0x080A0109 1800
waitram 1 0x0203CD92 0xFF 0 60
mashne A 4 0x0203761C 0xFFFFFFFF 0x080A0109 300
mashif A 1 0x020201CB 0xFF 1 4 0x0203761C 0xFFFFFFFF 0x080A01ED 600
waitram 1 0x0203CD92 0xFF 0 60
mashne A 4 0x0203761C 0xFFFFFFFF 0x080A01ED 300
waitsram 1800
evt saved
waitram 4 0x0203761C 0xFFFFFFFF 0x080A02D9 600
# ---- P9 leader menu (JOIN / LEAD / EXIT) -> LEAD
mashif A 1 0x020201CB 0xFF 1 1 0x0203CD94 0xFF 2 1800
waitram 1 0x0203CD92 0xFF 0 1
mash DOWN 1 0x0203CD92 0xFF 1 300
evt chose_lead
# ---- H1 mash A until the leader UI is up and awaiting players (state 6):
# the first A picks LEAD; any later ones land on the leader UI's init states.
mashptr A 1 0x02022C30 12 0xFF 6 1800
evt awaiting_players
# ---- H2 the join's request: accept prompt handle input (11) ---------------
waitptr 1 0x02022C30 12 0xFF 11 18000
waitram 1 0x0203CD92 0xFF 0 1
evt join_request
press A 2
waitptrne 1 0x02022C30 12 0xFF 11 600
# ---- H3 G1 finding: for a 2-player group the leader starts the activity by
# itself once the final member is accepted -- there is no "members OK?"
# prompt.  Nothing to press; H4 waits for the colosseum.
logptr lstate 1 0x02022C30 12
evt members_confirmed

# ---- H4 in the colosseum --------------------------------------------------
waitptr 2 0x03005D8C 0x04 0xFFFF 0x0000 3600
waitram 4 0x030022C4 0xFFFFFFFF 0x08085E5D 3600
wait 60
evt in_colosseum
# G1 finding: in a link room gObjectEvents[0] is the RECEPTIONIST; the link
# players are slots 1 (leader, spawns at the warp (6,8)) and 2 (member,
# (7,8)) -- overworld.c SpawnLinkPlayers.  Stride 0x24.
logram spawn_x 2 0x02037384
logram spawn_y 2 0x02037386
# ---- H5 walk to spot0 (3,5) = live (10,12).  G1 finding: in the link room
# movement goes through the link-key exchange and holdmash does NOT overshoot
# (unlike the Emerald overworld, HARNESS §4) -- aim at the exact tile; the
# waitram after each leg proves where the player stopped.
holdmash UP B 2 0x02037386 0xFFFF 12 300
waitram 2 0x02037386 0xFFFF 12 60
holdmash LEFT B 2 0x02037384 0xFFFF 10 300
waitram 2 0x02037384 0xFFFF 10 60
evt on_spot
# ---- H6 the battle is running, and it is a LINK DOUBLE -----------------
waitram 4 0x030022C4 0xFFFFFFFF 0x08038421 7200
logram btype 4 0x02022FEC
waitram 4 0x02022FEC 0x3 0x3 1
evt battle_started
# CROSS-CONSOLE FINGERPRINT (desync detector, RIG §2.9).  G1 finding: only the
# link MASTER runs the battle engine -- the member's gBattleMons stays zero --
# so the shared state is what BOTH consoles hold in their party copies, which
# the master's SETMONDATA commands keep current: HP (+0x56) and the encrypted
# substructures (+0x20..+0x4F: PP of the move lives there).  k* = personality
# + OT id (the decryption key, logged once); per turn d*a/d*b/h*.
# m* = gPlayerParty (own), e* = gEnemyParty (the peer's), stride 100.
logbytes km0 8 0x020244EC
logbytes km1 8 0x02024550
logbytes ke0 8 0x02024744
logbytes ke1 8 0x020247A8

# ---- T: 30 turns ----------------------------------------------------------
repeat 30
# T1 action menu for battler 0
waitram 4 0x03005D60 0xFFFFFFFF 0x08057589 10800
evt t1
# fingerprint at the turn boundary (both consoles are at their action menu)
logbytes km0 8 0x020244EC
logbytes dm0a 24 0x0202450C
logbytes dm0b 24 0x02024524
logram hm0 2 0x02024542
logbytes km1 8 0x02024550
logbytes dm1a 24 0x02024570
logbytes dm1b 24 0x02024588
logram hm1 2 0x020245A6
logbytes ke0 8 0x02024744
logbytes de0a 24 0x02024764
logbytes de0b 24 0x0202477C
logram he0 2 0x0202479A
logbytes ke1 8 0x020247A8
logbytes de1a 24 0x020247C8
logbytes de1b 24 0x020247E0
logram he1 2 0x020247FE
logram fo 1 0x0202433A
logram rq 1 0x030059E6
logram sq 1 0x03005C1A
waitram 1 0x020244AC 0xFF 0 1
# T2 FIGHT consumed
mashne A 4 0x03005D60 0xFFFFFFFF 0x08057589 300
evt t2_fight
waitramne 4 0x03005D60 0xFFFFFFFF 0x08057589 1
# T3 move menu for battler 0 (the owner's symptom: FIGHT -> move menu)
waitram 4 0x03005D60 0xFFFFFFFF 0x08057BFD 10800
evt t3_movemenu
waitram 1 0x020244B0 0xFF 0 1
# T4 GROWL consumed
mashne A 4 0x03005D60 0xFFFFFFFF 0x08057BFD 300
waitramne 4 0x03005D60 0xFFFFFFFF 0x08057BFD 1
evt t4_move
# T5-T8 battler 2
waitram 4 0x03005D68 0xFFFFFFFF 0x08057589 10800
evt t5
waitram 1 0x020244AE 0xFF 0 1
mashne A 4 0x03005D68 0xFFFFFFFF 0x08057589 300
evt t6_fight
waitram 4 0x03005D68 0xFFFFFFFF 0x08057BFD 10800
evt t7_movemenu
waitram 1 0x020244B2 0xFF 0 1
mashne A 4 0x03005D68 0xFFFFFFFF 0x08057BFD 300
waitramne 4 0x03005D68 0xFFFFFFFF 0x08057BFD 1
evt t8_move
endrepeat

# one last fingerprint, after turn 30 resolved
waitram 4 0x03005D60 0xFFFFFFFF 0x08057589 10800
evt t1
logbytes km0 8 0x020244EC
logbytes dm0a 24 0x0202450C
logbytes dm0b 24 0x02024524
logram hm0 2 0x02024542
logbytes km1 8 0x02024550
logbytes dm1a 24 0x02024570
logbytes dm1b 24 0x02024588
logram hm1 2 0x020245A6
logbytes ke0 8 0x02024744
logbytes de0a 24 0x02024764
logbytes de0b 24 0x0202477C
logram he0 2 0x0202479A
logbytes ke1 8 0x020247A8
logbytes de1a 24 0x020247C8
logbytes de1b 24 0x020247E0
logram he1 2 0x020247FE
logram fo 1 0x0202433A
evt turns_done
# keep the link alive while the peer finishes its own last turn
wait 600
evt script_end
