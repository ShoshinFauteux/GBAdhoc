# emerald_trade_host.inputs — Union Room trade, HOST side (the registrant).
# Gate 3 (plan §5 Phase 3): starts from testdata/fixtures/emerald_parkedB.sav
# (CLONEB parked at Mauville PC 2F (6,4) facing the Union Room attendant).
#
# Flow (pret union_room.c / cable_club.inc, addresses in docs/AUTOPILOT.md):
#   CONTINUE -> talk to attendant -> YES -> in-game save -> warp Union Room
#   -> walk to the registration nurse (3,2) -> register party slot 2
#   (Magcargo) on the trading board requesting type DRAGON (= the joiner's
#   offered slot-1 Salamence) -> retreat to (3,5) -> mash A: the joiner's
#   contact + accept prompt + trade start all ride on A -> CB2_LinkTrade
#   animation -> automatic in-game save (CB2_SaveAndEndWirelessTrade)
#   -> back in the Union Room -> log the post-trade party (oracle).
#
# Trade oracle for run_trade_test.sh: pre0/pre1 vs post0/post1 —
# host gives slot-2 personality (pre1), receives the joiner's slot-1 into
# slot 2: post1 == joiner pre0, post0 == pre0.
# NOTE: no `ff on` — a netdrv session is active, FF is interlocked to 1x.

# --- boot -> title -> CONTINUE -> overworld (parked at PC2F (6,4)) -----------
mash A 4 0x030022C4 0xFFFFFFFF 0x080AAB2D 21600
evt title_ok
mash START 4 0x030022C4 0xFFFFFFFF 0x0802F6B1 3600
mash A 4 0x030022C4 0xFFFFFFFF 0x08085E5D 7200
evt overworld_ok
wait 30
logptr start_loc 2 0x03005D8C 0x04
logram pre0 4 0x020244EC
logram pre1 4 0x02024550

# --- talk to the Union Room attendant: welcome -> YES -> save -> warp --------
press UP 2
wait 10
mashsram A 5400
evt entry_saved
mashptr A 2 0x03005D8C 0x04 0xFFFF 0x3C19 3600
evt in_union_room

# --- wait for the Union Room task to reach UR_STATE_MAIN ---------------------
waitptr 1 0x02022C30 0x14 0xFF 4 1800
evt ur_main

# --- navigate (7,11) -> row 10 -> column 3 -> (3,3), facing the nurse --------
holdmash UP B 2 0x02037362 0xFFFF 17 600
holdmash DOWN B 2 0x02037362 0xFFFF 17 600
holdmash LEFT B 2 0x02037360 0xFFFF 10 900
holdmash RIGHT B 2 0x02037360 0xFFFF 10 600
holdmash UP B 2 0x02037362 0xFFFF 10 900

# --- register: talk -> REGISTER -> party menu -> slot 2 -> Register ----------
mash A 4 0x030022C4 0xFFFFFFFF 0x081B01B1 1800
wait 60
press DOWN 4
wait 20
press A 4
wait 30
press A 4
# back on the field: "choose requested type" list menu (UR state 52)
mashptr A 1 0x02022C30 0x14 0xFF 52 1800
wait 30
# DRAGON is row 14 of the request-type menu (data/union_room.h order)
repeat 14
press DOWN 2
wait 6
endrepeat
press A 4
# registration-complete text -> back to UR_STATE_MAIN
mashptr A 1 0x02022C30 0x14 0xFF 4 1800
evt registered
dump

# --- retreat one tile to (3,4) facing down: its facing tile (3,5) is neither
# the nurse, the board, nor any avatar spot (leader spots +/- group offsets),
# so a later stray A can never start an interaction --------------------------
holdmash DOWN B 2 0x02037362 0xFFFF 11 600

# --- wait HANDS OFF until the joiner contacts us (UR state leaves MAIN);
# only then mash A: contact msg -> trade request -> accept YES -> trade -------
evt wait_partner
waitptrne 1 0x02022C30 0x14 0xFF 4 21600
evt contacted
mash A 4 0x030022C4 0xFFFFFFFF 0x0807AE51 21600
evt trade_anim

# --- trade animation runs itself; ends in an automatic in-game save ----------
mashsram A 18000
evt post_save

# --- back to the Union Room field, then read the oracle ----------------------
mash A 4 0x030022C4 0xFFFFFFFF 0x08085E5D 7200
wait 60
logram post0 4 0x020244EC
logram post1 4 0x02024550
logram recv0 4 0x02024744
logptr end_loc 2 0x03005D8C 0x04
dump
evt trade_complete
wait 60

# ===========================================================================
# EXIT-ROOM LEG, "stay" variant (run_exit_room_test.sh --leaver=join).
# This side does NOT leave the Union Room: it idles at its post-trade tile
# and samples gMain.callback2 while the PARTNER walks out.  If the game's
# fatal wireless screen ("...please turn off the power", CB2_PrintErrorMessage
# 0x0800B1A1) is caused by a partner departing while our netdrv session stays
# up, this is the side that shows it — and the run tells us whether it takes
# both sides leaving or only one.
# Hands off entirely: no A presses, so nothing here can start an interaction.
# ===========================================================================
evt stay_begin
wait 600
logram cb2_stay1 4 0x030022C4
wait 600
logram cb2_stay2 4 0x030022C4
dump
wait 900
logram cb2_stay3 4 0x030022C4
waitptr 1 0x02022C30 0x14 0xFF 4 1800
evt ur_main_still
wait 600
logram cb2_stay4 4 0x030022C4
dump
evt exit_room_done
wait 60
