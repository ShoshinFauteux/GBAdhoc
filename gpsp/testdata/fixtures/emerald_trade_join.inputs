# emerald_trade_join.inputs — Union Room trade, JOIN side (the offerer).
# Gate 3: starts from testdata/fixtures/emerald_parkedA.sav (AUSTIN parked at
# Mauville PC 2F (6,4) facing the Union Room attendant).
#
# Flow: CONTINUE -> attendant -> YES -> in-game save -> warp Union Room ->
# wait out the host's registration -> walk to the trading board (2,1),
# stand (2,2) facing up -> mash A. The single mash rides the whole chain:
# empty-board cycles (open -> EXIT) are harmless until the host's listing
# appears; then: select listing -> "ask to trade?" YES -> "which mon" ->
# party menu slot 1 (Salamence, matches the requested DRAGON type) -> TRADE
# action -> link connect -> host accepts -> CB2_LinkTrade. Then the
# animation runs itself and ends in an automatic in-game save.
#
# Oracle: join gives slot-1 personality (pre0), receives the host's
# registered slot-2 mon into slot 1: post0 == host pre1, post1 == pre1.
# NOTE: no `ff on` — a netdrv session is active, FF is interlocked to 1x.

# --- boot -> title -> CONTINUE -> overworld (parked at PC2F (6,4)) -----------
mash A 4 0x030022C4 0xFFFFFFFF 0x080AAB2D 4800
evt title_ok
mash START 4 0x030022C4 0xFFFFFFFF 0x0802F6B1 3600
mash A 4 0x030022C4 0xFFFFFFFF 0x08085E5D 4800
evt overworld_ok
wait 30
logptr start_loc 2 0x03005D8C 0x04
logram pre0 4 0x020244EC
logram pre1 4 0x02024550

# --- talk to the Union Room attendant: welcome -> YES -> save -> warp --------
press UP 2
wait 10
mashsram A 4800
evt entry_saved
mashptr A 2 0x03005D8C 0x04 0xFFFF 0x3C19 3600
evt in_union_room

# --- wait for the Union Room task to reach UR_STATE_MAIN ---------------------
waitptr 1 0x02022C30 0x14 0xFF 4 1800
evt ur_main

# --- give the host time to register on the trading board (~45 s) -------------
wait 2700

# --- navigate (7,11) -> row 10 -> column 2 -> (2,2), facing the board --------
holdmash UP B 2 0x02037362 0xFFFF 17 600
holdmash DOWN B 2 0x02037362 0xFFFF 17 600
holdmash LEFT B 2 0x02037360 0xFFFF 9 900
holdmash RIGHT B 2 0x02037360 0xFFFF 9 600
holdmash UP B 2 0x02037362 0xFFFF 9 900
evt at_board

# --- one mash from the board to the trade screen -----------------------------
mash A 4 0x030022C4 0xFFFFFFFF 0x0807AE51 4800
evt trade_anim

# --- trade animation runs itself; ends in an automatic in-game save ----------
mashsram A 4800
evt post_save

# --- back to the Union Room field, then read the oracle ----------------------
mash A 4 0x030022C4 0xFFFFFFFF 0x08085E5D 4800
wait 60
logram post0 4 0x020244EC
logram post1 4 0x02024550
logram recv0 4 0x02024744
logptr end_loc 2 0x03005D8C 0x04
dump
evt trade_complete
wait 60
