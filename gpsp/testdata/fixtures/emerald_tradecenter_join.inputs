# v10: + the WATCHDOG probes.  overworld.c's CheckRfuKeepAliveTimer is a
# 61-consecutive-frame per-episode watchdog (sRfuKeepAliveTimer, reset on
# every SetKeyInterceptCallback) whose expiry calls LinkRfu_FatalError --
# disconnectMode=RFU_DISCONNECT_ERROR -> the deliberate 0x30 -> press-A.
#   ka1/2/3   sRfuKeepAliveTimer (u8) -- how close to 61 the episode got
#   kcb1/2/3  sPlayerKeyInterceptCallback -- WHICH episode (decode:
#     ReadButtons=0x0808700D SelfIdle=0x080870B1 Idle=0x080870ED
#     DeferToEventScript=0x080870F9 DeferToRecvQ=0x0808711D
#     DeferToSendQ=0x08087141 ExitingSeat=0x08087165 Ready=0x08087171
#     SetReady=0x080871AD SendNothing=0x080871C1 WaitForPlayersToExit=0x080871C5
#     SendExitRoomKey=0x080871FD InLinkActivity=0x08087211  (thumb +1)
#   pls1/2/3  sPlayerLinkStates[0..3] packed u32 (2=EXITING_ROOM per byte)
#   lerr      sLinkErrorBuffer[0..3] -- the error screen's own record
# v9 (2026-08-09 evening): + EXIT-STATE probes.  Run 305 proved neither
# console completes the negotiated close: the join deliberately issues
# RFU_CMD_DISCONNECT mid-healthy-exchange and only warps AFTER its link
# dies; the host black-screens waiting, then does the same.  These probes
# catch the close-link state at the door and after the warp:
#   rc0/rc1_out  gRfu.readyCloseLink[0]/[1] -- did READY_CLOSE_LINK ever
#                exchange?  (0,0 = the close handshake never started)
#   st_out/_end  gRfu.status (2 = CONNECTION_ERROR)
#   es_end       gRfu.errorState (1=OCCURRED -> the press-A screen; 4=DISCONNECTING = graceful)
#   lr_end       linkLossRecoveryState (2=loss-disconnected, 4=recovery-failed)
#   dm_end       disconnectMode at the end
# All zero-frame logram: injection-identical to v8 by construction.
# v8 PROBE (2026-08-09): v7 + THE GATE A CHAIN-CLOSERS.
# gRfu's guest address is RESOLVED: pret/pokeemerald `symbols` branch,
# pokeemerald.sym for the retail-matching build.  Validated two ways before
# use: gMain reads 0x030022C0 (byte-identical to the address already proven in
# production by the cb2 predicates below), and the sym file's gRfu size 0xCF4
# equals sizeof(struct RfuManager) in include/link_rfu.h.  Offsets from that
# header:  gRfu=0x03005000, recvQueue.count=+0x124+0x8C2 -> 0x030059E6,
# sendQueue.count=+0x9E8+0x232 -> 0x03005C1A, gHeldKeyCodeToSend=0x03005DA8.
# All new ops are zero-frame logram, so v8 is injection-identical to v7 (and
# therefore to v6) by the same argument as the v7 header below.
#
# READING THE GATE A RESULT on a swallowed UP (y unchanged):
#   hk_upN=0x40, hkc_upN=0x00, sq_upN>=2  -> Gate A CONFIRMED end to end:
#       the game read UP, UpdateHeldKeyCode nulled it because the send queue
#       sat >=2.  This is the number HANDOVER 5.1 said was never measured.
#   hk_upN=0x40, hkc_upN=0x00, sq_upN<=1  -> the null came from ANOTHER branch
#       (IsSendingKeysToLink etc.) -- Gate A is NOT the mechanism.  Say so.
#   hkc_upN=0x11 (EMPTY) or a key code    -> the key was NOT nulled; the eaten
#       input lives elsewhere (recv-queue Gate B lock, or game scene state).
#   rq_upN>4 on any sample                -> Gate B was live at that moment.
# emerald_tradecenter_join.inputs -- DIRECT CORNER trade, JOIN side.
#
# Rewritten whole rather than patched; see the host script's header for the
# reason and for the full derivation of every address and coordinate here.
#
# Identical to the host up to the role menu.  Two differences only:
#   * role: JOIN GROUP is entry 0, so the cursor is already on it and this
#     side needs no Down -- just the confirm.
#   * seat: Chair1 at map (7,5) instead of Chair0 at map (4,5), and this
#     console is object slot 2 (spawned on warp tile map (6,8)), not slot 1.

# --- boot to the overworld -------------------------------------------------
mash A 4 0x030022C4 0xFFFFFFFF 0x080AAB2D 4800
evt title_ok
mash START 4 0x030022C4 0xFFFFFFFF 0x0802F6B1 3600
mash A 4 0x030022C4 0xFFFFFFFF 0x08085E5D 4800
evt overworld_ok
wait 30
logptr start_loc 2 0x03005D8C 0x04
logram pre0 4 0x020244EC
logram pre1 4 0x02024550

# --- walk to the DIRECT CORNER attendant -----------------------------------
# live (13,11) -> down to row 5 (row 4 is blocked at map x=8) -> right -> up
# in front of her counter.  You talk ACROSS the counter, so no further step.
holdmash DOWN  B 2 0x02037362 0xFFFF 12 900
holdmash RIGHT B 2 0x02037360 0xFFFF 17 900
holdmash UP    B 2 0x02037362 0xFFFF 11 900
press UP 2
evt at_direct_corner

# --- talk; TRADE is entry 0; she forces a save before linking --------------
mash A 4 0x030022C4 0xFFFFFFFF 0x08085E5D 1800
mashsram A 4800
evt entry_saved

# --- ROLE: JOIN GROUP (entry 0, already under the cursor) ------------------
# Same generous spacing as the host: mashsram over-mashes slightly past the
# save, so settle, advance the one dialogue, let the menu clear its 12-frame
# input lockout, then confirm.  No Down on this side.
wait 600
press A 10
wait 600
press A 10
evt chose_join_group
wait 300

# --- confirm the group we find, then ride the warp into the TRADE CENTER ---
mashptr A 2 0x03005D8C 0x04 0xFFFF 0x1919 4800
evt in_trade_center

# --- who and where are we?  (kept: this is how the slot bug was found) -----
wait 300
logptr sb1_x 2 0x03005D8C 0x00
logptr sb1_y 2 0x03005D8C 0x02
logram o1_x 2 0x02037384
logram o2_x 2 0x020373A8
dump
# FULL-SPEED FAILURE (2026-08-06): every seat leg logged the SAME coordinate
# and the avatar never moved -- host (13,9), join (9,9), nowhere near the
# expected spawn of live (12,15)/(13,15).  That is not the overshoot race nor a
# dropped step; those moved.  Before blaming the presses, establish WHICH object
# is actually ours: slot 0 is the receptionist in this room, and the slot the
# players occupy has been assumed, not re-verified at this frame rate.
logram s0_x 2 0x02037360
logram s0_y 2 0x02037362
logram s1_x 2 0x02037384
logram s1_y 2 0x02037386
logram s2_x 2 0x020373A8
logram s2_y 2 0x020373AA
logptr map_id 2 0x03005D8C 0x04
evt tc_coords_logged
# === ADR-0081 IDENTICAL-INPUT DROP TEST =====================================
# Same open-loop inputs on BOTH consoles, linked in the Trade Center. UP/DOWN
# are identical for host and join (no route mirror). Oscillate within ONE tile
# so wall/space cannot confound; each press MUST toggle y by 1. A press that
# leaves y unchanged was DROPPED. sq = gRfu.sendQueue.count (Gate A) at that
# instant, so every drop is tagged with the send-queue depth that caused it.
# Host should toggle every time; a slower/dropping client will miss some.
evt drop_test_begin
logram dt_y0 2 0x020373AA
logram dt_sq0 1 0x03005C1A
press UP 12
logram dt_y1 2 0x020373AA
logram dt_sq1 1 0x03005C1A
press DOWN 12
logram dt_y2 2 0x020373AA
logram dt_sq2 1 0x03005C1A
press UP 12
logram dt_y3 2 0x020373AA
logram dt_sq3 1 0x03005C1A
press DOWN 12
logram dt_y4 2 0x020373AA
logram dt_sq4 1 0x03005C1A
press UP 12
logram dt_y5 2 0x020373AA
logram dt_sq5 1 0x03005C1A
press DOWN 12
logram dt_y6 2 0x020373AA
logram dt_sq6 1 0x03005C1A
press UP 12
logram dt_y7 2 0x020373AA
logram dt_sq7 1 0x03005C1A
press DOWN 12
logram dt_y8 2 0x020373AA
logram dt_sq8 1 0x03005C1A
evt drop_test_end
# === end drop test =========================================================

# --- take Chair1, watching OUR object slot (2) -----------------------------
# spawn map (6,8)=live(13,15) -> up to row 6 -> right -> up onto the trigger at
# map (7,5)=live(14,12).  Row 5 is blocked at map x=5/6, hence the detour.
# Per-leg coordinates: a blocked leg holds into a wall until timeout and the
# next leg starts from the wrong tile.  This side is the one that ended up a
# tile up and right of its chair, and the log could not say which leg did it.
# RUN 12: holdmash OVERSHOOTS BY EXACTLY ONE TILE, INTERMITTENTLY.
# Measured, all three legs plus the corrective:
#   in1 (UP  ->13) = (13,13)  correct
#   in2 (RIGHT->14) = (15,13)  one past
#   in3 (UP  ->12) = (15,11)  one past
#   in4 (LEFT ->14) = (13,11)  the CORRECTIVE overshot too
# holdmash releases the button the frame its predicate matches
# (fe_autopilot.c:475), but the game has already committed the next step, so
# whether it lands is a per-frame race -- runs 10 and 11 were clean, 12 was not.
# A corrective built on the same primitive inherits the same race and
# oscillates instead of converging, which is exactly what in4 shows.
#
# The route is short and fully deterministic: the spawn is a fixed warp
# destination, observed at live (13,15) in every run 6-12, and the chair is
# live (14,12).  So it is exactly UP, UP, RIGHT, UP.  Counted single steps
# cannot race.  RUN 15: a 4-frame press is only a TAP -- it turns you to face a
# direction without stepping, which is why run 15's client barely moved.  12
# frames covers turn-then-step; 40 lets the 16-frame walk finish.
# ===================================================================
# RUNS 175-177 (2026-08-07): THE COUNTED ROUTE IS THE BUG, AND IT IS **Y**.
# ===================================================================
# Three consecutive runs, identical binary, identical script.  Spawn is
# (13,15) in all three; the chair is (14,12).  After the two counted UP legs:
#
#   run 177  in1 = (13,13)   both steps landed     -> TRADE COMPLETED
#   run 176  in1 = (13,14)   ONE step landed       -> ap_fail line 122
#   run 175  in1 = (13,15)   ZERO steps landed     -> ap_fail line 122
#
# So `press UP 12` is swallowed intermittently -- 0, 1 or 2 of the two land --
# and the count is not a property of the route, it is a coin flip.
#
# X WAS NEVER THE PROBLEM.  It is a downstream symptom, which is exactly why
# `in2_x == 14` predicted the party oracle with no exceptions in 62 runs: x can
# only reach 14 if y was already right.  On a lower row the wall is to the
# right, so `press RIGHT` walks into it and x stays 13 -- and then the ONLY
# backstop was the LEFT corrective below, written for the run-9 OVERSHOOT, so
# it walked away from the target into the opposite wall and timed out.  Watched
# on the hardware: right into a wall, left into the other wall, dead.  The y
# backstop existed but sat AFTER the x one, so the x one always timed out first
# and y was never corrected.
#
# THE FIX IS TO STOP COUNTING STEPS AND START CONFIRMING THEM.  Every leg is
# now a waypoint: hold the direction until the coordinate actually reads the
# waypoint value.  holdmash evaluates its predicate BEFORE injecting anything
# (fe_autopilot.c:475), so a leg whose waypoint is already satisfied is a true
# no-op -- which means a swallowed press costs time, not the run.
#
# Waypoints follow the same path the passing run took, (13,15) -> (13,13) ->
# (14,13) -> (14,12), so nothing here explores new tiles.
holdmash UP B 2 0x020373AA 0xFFFF 13 300
wait 20
logram in1_x 2 0x020373A8
logram in1_y 2 0x020373AA
holdmash RIGHT B 2 0x020373A8 0xFFFF 14 300
# THIS `wait` IS LOAD-BEARING.  Do not remove it and do not move it below the
# LEFT.  holdmash exits the frame its predicate first matches, with a step
# ALREADY COMMITTED, so at this instant x reads 14 and is about to become 15.
# Run it straight into the LEFT normaliser and the LEFT sees x == 14, treats
# its waypoint as satisfied, and no-ops -- and THEN the committed step lands.
# Measured: in2_x = 15 in nine consecutive runs, v2 through v4, and in v4 the
# normalisation pair provably never fired.  v3 happened to work here only
# because it had this wait in this position by accident.
#
# 20 frames lets the committed step land, so the LEFT below sees the true 15.
wait 20
# X IS NORMALISED HERE, BEFORE THE CHAIR STEP -- NOT AFTER IT.
#
# v3 put the two counted UP presses first and left this backstop at the end,
# and that ordering is deterministically fatal.  The RIGHT waypoint above
# overshoots to x=15 in 6 OF 6 RUNS (holdmash releases the frame its predicate
# matches, but a step is already committed).  With x=15 there is no chair
# underneath, so nothing absorbs the presses and they simply walk:
#
#   in1                 (13,13)
#   holdmash RIGHT      (15,13)   overshoots, every run
#   press UP            (15,12)   would be the chair IF x were 14
#   press UP            (15,11)   nothing to sit on, so it MOVES
#   holdmash LEFT       (14,11)   x backstop works, one tile too late
#   holdmash DOWN       TIMES OUT -> ap_fail line 165
#
# The v3 reasoning ("a press cannot overshoot; two cover a swallowed press;
# sitting is absorbing") is sound but CONDITIONAL ON X BEING RIGHT -- absorption
# requires standing on the chair.  v2's y-overshoot was intermittent (2/4
# traded); v3's was guaranteed (0/2, and would stay 0/N).
#
# So x is settled to 14 while still on row 13, and only then does the console
# step onto the chair.  Whether the chair is enterable from the north is STILL
# UNTESTED and this ordering means it never has to be.
# v5 FAILED, AND IT FAILED BECAUSE OF THE `wait` ABOVE.  Chaining two holdmash
# correctives OSCILLATES: RIGHT settles at 15 (the committed step), then LEFT
# exits the frame x reads 14 with ITS OWN step committed, and lands on 13.
# Measured 4/4: in2_x = 13, in3 unchanged, ap_fail line 189.  The original
# author wrote this down after run 12 -- "a corrective built on the same
# primitive inherits the same race and oscillates instead of converging" -- and
# I rebuilt the same trap from the other side.
#
# SO: EACH PRIMITIVE IS NOW USED ONLY WHERE IT HAS DIRECT EVIDENCE.
#   holdmash  reliable for the APPROACH.  `RIGHT -> 14` settles at 15 in 9 of 9
#             runs across v2/v3/v4 -- deterministic, just off by one.
#   press     reliable for a SINGLE TILE.  v1's counted `press RIGHT` landed
#             x = 14 in both runs that reached it; a press cannot overshoot.
#   waitram   the assert.  Free when correct, and it fails ON THE LINE that
#             names the axis instead of somewhere in the trade handshake.
#
# One tile back from a known 15, counted, then checked.
#
# v7 PROBE: `press B N` == `hold B N` + N_gap frames of zero.  OP_PRESS injects
# buttons on step_frame 0..N-1 then 0 on the AP_PRESS_GAP(=2) frames after, and
# OP_LOGRAM returns 0 (fe_autopilot.c:429) so it costs ZERO frames.  Therefore
#     press X 12 / wait 60      ==  12 held + 62 zero
#     hold  X 12 / logram... / wait 62  ==  12 held + 62 zero
# byte-for-byte identical injection.  The ONLY reason to rewrite it is that a
# logram placed after `press` (or after `holdmash`) samples a RELEASED frame --
# both return 2 having injected 0, and r==2 consumes the frame, so the logram
# runs the frame AFTER the release and would read heldKeys=0 on a leg that
# worked.  That would be a FALSE KILL of the finding.  After `hold`, the exit
# frame is a HELD frame, so the logram samples the key we actually injected.
#
# THIS LEG IS THE POSITIVE CONTROL.  The waitram below asserts x==14, so when
# this leg works we know it worked -- and hk_left must read LEFT(0x20).  If the
# control shows 0x20 and the UP legs below show 0x40 while y never moves, the
# input path is exonerated.  If hk_left is 0 the probe itself is wrong and
# nothing below it may be believed.
hold LEFT 12
logram hk_left 2 0x030022EC
logram hkraw_left 2 0x030022E8
logram x_left 2 0x020373A8
logram sq_left 1 0x03005C1A
logram rq_left 1 0x030059E6
logram hkc_left 2 0x03005DA8
wait 62
waitram 2 0x020373A8 0xFFFF 14 120
logram in2_x 2 0x020373A8
logram in2_y 2 0x020373AA
# THE CHAIR STEP IS COUNTED, NOT CONFIRMED -- and this is the one place
# counting is right.  A holdmash here would overshoot north of the chair for
# the same committed-step reason as the x leg.  By this line x has been
# normalised to 14 and y confirmed at 13, so the console is one tile SOUTH of
# the chair and a single press cannot overshoot.  Two of them, because a
# swallowed press is the other failure mode and sitting is absorbing -- once
# seated the trade flow owns the input and a second UP is a no-op.
# v7 PROBE, THE DECISIVE PAIR.  Same injection-identical rewrite as the LEFT
# control above.  y is sampled on the SAME frame as heldKeys so the two cannot
# be misaligned by a step boundary.
#   hk_upN == 0x40 (UP) and y_upN unchanged  -> the game READ our key and threw
#       it away.  Input path exonerated, Gate B confirmed, hyp 2 and 3 dead.
#   hk_upN == 0 while the control hk_left == 0x20 -> we really are losing input
#       on link frames.  THE FINDING IS KILLED.  Say so loudly.
hold UP 12
logram hk_up1 2 0x030022EC
logram hkraw_up1 2 0x030022E8
logram nk_up1 2 0x030022EE
logram y_up1 2 0x020373AA
logram sq_up1 1 0x03005C1A
logram rq_up1 1 0x030059E6
logram hkc_up1 2 0x03005DA8
wait 62
hold UP 12
logram hk_up2 2 0x030022EC
logram hkraw_up2 2 0x030022E8
logram nk_up2 2 0x030022EE
logram y_up2 2 0x020373AA
logram sq_up2 1 0x03005C1A
logram rq_up2 1 0x030059E6
logram hkc_up2 2 0x03005DA8
wait 62
logram in3_x 2 0x020373A8
logram in3_y 2 0x020373AA

# LAST-RESORT y BACKSTOP.  Only reachable if both counted presses were
# swallowed AND the chair was missed; it is a no-op on the chair row.  It is
# NOT the x backstop any more -- that one now runs before the chair step.
holdmash DOWN B 2 0x020373AA 0xFFFF 12 300
wait 20
logram in4_x 2 0x020373A8
logram in4_y 2 0x020373AA

# ASSERT THE SEAT BEFORE CLAIMING IT.  `evt seated` used to fire on nothing but
# reaching this line, and the y backstop above tests y ALONE -- so at x=15 the
# `y == 12` predicate is satisfied by open floor one tile east of the chair.
# Measured in runs 13 and 14: (15,11) -> (15,12), backstop "succeeded",
# `seated` was emitted, and the run then died 60+ lines later at the
# `waitramne` on callback2 with no indication why.  The player was standing
# BESIDE the chair, never on it.
#
# Two single-axis waits are the AND the grammar does not have.  They cost
# nothing on a correct run (the predicate is already true, so each returns on
# its first evaluation) and they fail the run AT THE REAL CAUSE, on a line that
# names the axis, instead of as a mystery timeout in the trade handshake.
waitram 2 0x020373A8 0xFFFF 14 120
waitram 2 0x020373AA 0xFFFF 12 120
evt seated

# --- the trade -------------------------------------------------------------
# See the host script for the full derivation.  Short version: this is the
# TRADE CENTER terminal, governed by trade.c, NOT the union-room board in
# party_menu.c.  trade.c CB_ProcessSelectedMonInput() is case 0 = Summary,
# case 1 = Trade, with the cursor initialised to 0 -- so SUMMARY is first here
# and TRADE needs one Down.  Mashing A just reopens the summary forever.

# Press nothing while seated: the "press B to exit the chair" dialog is
# waiting on the partner, and B would stand us back up.  Watch instead for
# gMain.callback2 leaving CB2_Overworld -- that edge is the handover to the
# trade screen, and it costs no address we do not already have.
waitramne 4 0x030022C4 0xFFFFFFFF 0x08085E5D 3600
evt trade_screen
logram cb2_trade 4 0x030022C4
wait 900
dump

press A 10
wait 90
dump

# Menu_ProcessInputNoWrap() clamps at the bottom entry, so the second Down is
# free insurance.  (The LINK LEADER menu is the opposite -- it wraps onto EXIT
# and aborts, so that one gets exactly one Down.)
press DOWN 10
wait 30
press DOWN 10
wait 60
dump
press A 10
evt trade_selected

wait 180
dump
logram cb2_confirm 4 0x030022C4
evt trade_attempted

mash A 4 0x030022C4 0xFFFFFFFF 0x0807AE51 4800
evt trade_anim
mashsram A 4800
evt post_save

# --- LEAVE THE TRADE SCREEN ------------------------------------------------
# See the host script for the derivation.  Short version: a finished trade puts
# you back on CB_MAIN_MENU, A only reopens { SUMMARY, TRADE }, and there is no
# B exit -- you must land on CANCEL (position 12).  With a 3-mon party
# RIGHT from 0 -> 1, then DOWN from 1 skips inactive 3 and 5 and lands on 12.
#
# BUT FIRST, WAIT OUT THE SAVE -- see the host script.  mashsram returns on the
# first SRAM checksum change and Emerald keeps "SAVING..." up long past it; all
# three of run 7's exit screenshots still showed that box, so every press in
# this section was swallowed and the route was never exercised.
# MEASURED IN RUN 8: save screen callback2 is 0x0807EB51, and the game does NOT
# come back to 0x080773D1 afterwards -- waiting for that stalled run 8 for its
# full 3600-frame timeout.  Wait for the save screen to be LEFT instead; that
# transition is confirmed, the destination is not.  See the host script.
logram cb2_saving 4 0x030022C4
wait 120
waitramne 4 0x030022C4 0xFFFFFFFF 0x0807EB51 3600
evt menu_interactive
logram cb2_ready 4 0x030022C4
wait 180
dump

# RUN 9: after the save comes "Communication standby... Please wait." while the
# consoles resync -- cb2_ready=0x080773AD is that standby, NOT the menu.  Run 9
# pressed RIGHT/DOWN straight into it and the cursor never moved.  Ride it out
# with B (inert on the live menu, harmless during the box); never A, which
# would select a mon once the menu is up.  See the host script.
# RUN 10: callback2 CANNOT tell the standby box from the live menu -- cb2_menu
# read 0x080773D1, identical to cb2_trade, while the screen still showed
# "Communication standby...".  The box is drawn inside the same callback.  Do
# not attempt waitram detection again; use a bounded wait.  Measured: standby
# runs ~600 frames from menu_interactive (512 frames of B was short, menu was
# live 84 frames later).  See the host script.
repeat 22
press B 4
wait 60
endrepeat
wait 240
logram cb2_menu 4 0x030022C4
dump

press RIGHT 10
wait 30
press DOWN 10
wait 30
dump
press A 10
wait 120
dump
press A 10
evt trade_menu_exited

mash A 4 0x030022C4 0xFFFFFFFF 0x08085E5D 4800
evt back_on_map
wait 120

# --- WALK OUT ---------------------------------------------------------------
# Reverse of the route in: chair1 live (14,12) -> down to row 6 -> left to the
# warp column -> down onto the warp at map (6,8) = live (13,15).
holdmash DOWN B 2 0x020373AA 0xFFFF 13 900
logram sq_out 1 0x03005C1A
logram rq_out 1 0x030059E6
logram dm_out 1 0x03005CE4
logram err_out 1 0x030050EE
logram out1_x 2 0x020373A8
logram out1_y 2 0x020373AA
logram ka1 1 0x03000E19
logram kcb1 4 0x03000E14
logram pls1 4 0x03000E10
holdmash LEFT B 2 0x020373A8 0xFFFF 13 900
logram out2_x 2 0x020373A8
logram out2_y 2 0x020373AA
logram rc0_out 1 0x030050E4
logram rc1_out 1 0x030050E5
logram st_out 1 0x030050F1
logram ka2 1 0x03000E19
logram kcb2 4 0x03000E14
logram pls2 4 0x03000E10
# RUN 11: this side's final DOWN leg timed out entirely (out2 = (13,13), no
# out3), while the host reached its warp tile exactly and STILL did not warp.
# A coordinate cannot detect a warp: the map change moves the object being
# watched, so the predicate is raced, and the leg has already stopped pushing.
# Watch the map id and hold DOWN until it changes.  See the host script.
# LEAVING IS A CONVERSATION: the attendant asks whether you want to leave, so
# reaching the tile is not enough -- run 11's host stood on it exactly and never
# warped because nothing answered her.  Mash A (never B, which would decline)
# while holding DOWN, and watch the map id rather than a coordinate.  See the
# host script.
evt walking_out
holdmashptr DOWN A 2 0x03005D8C 0x04 0xFFFF 0x060A 1800
evt left_trade_center
logram st_end 1 0x030050F1
logram es_end 1 0x030050EE
logram lr_end 1 0x030050F0
logram dm_end 1 0x03005CE4
logram ka3 1 0x03000E19
logram kcb3 4 0x03000E14
logram pls3 4 0x03000E10
logram lerr 4 0x02022B00
wait 60

# --- oracle inputs ---------------------------------------------------------
logram post0 4 0x020244EC
logram post1 4 0x02024550
logram recv0 4 0x02024744
logptr end_loc 2 0x03005D8C 0x04
dump
evt trade_complete
wait 60
